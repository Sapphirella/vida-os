{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidaOS",
  "version": "1.0.1",
  "identifier": "com.vidaos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VidaOS",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "你的私密生活记录空间",
    "longDescription": "VidaOS：文章、动态、碎片、灵感、日程、待办、馆藏与 Agent，全部数据只存在本机，离线可用。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
